# Documentos reales: nunca se versionan (además lo bloquea el hook de pre-commit).
data/real/

# Todo lo demás en data/ se ignora, salvo las muestras sintéticas pequeñas.
data/*
!data/synthetic/
data/synthetic/*
!data/synthetic/samples/

